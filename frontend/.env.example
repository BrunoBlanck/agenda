# Copie para .env.local se precisar mudar algo. Sem estas linhas, o front usa /api na mesma origem.

# Endereço da API em produção (ex.: https://api.exemplo.com). Vazio = mesma origem (/api).
VITE_API_URL=

# Só em desenvolvimento: para onde o Vite encaminha /api (padrão: http://localhost:8000)
API_PROXY_ALVO=http://localhost:8000
