# Copie para .env.local se precisar mudar algo. Sem estas linhas, o front usa /api na mesma origem.

# Endereço da API em produção (ex.: https://api.exemplo.com). Vazio = mesma origem (/api), atrás do nginx.
VITE_API_URL=

# Só no `npm run dev` e no `npm run preview`: endereço do back-end. O Vite imita o nginx em localhost:5173
# (GER-29): /_app/... é o front, /superadmin e /{slug}/painel entregam o app, e todo o resto (/api, /, /{slug})
# vai para este endereço. Padrão: http://localhost:8000
API_PROXY_ALVO=http://localhost:8000

# Porta do `npm run dev` e do `npm run preview`. Padrão: 5173
# PORTA_DEV=5173
