# Copie para .env e ajuste. Nunca commite o .env.

AMBIENTE=desenvolvimento

# --- Postgres do docker compose (só usados pelo docker-compose.yml) ---
POSTGRES_USUARIO=agenda
POSTGRES_SENHA=agenda_dev
POSTGRES_BANCO=agenda
POSTGRES_PORTA=5433

# Dono do schema: roda as migrações e cria o papel da aplicação.
DATABASE_OWNER_URL=postgresql+psycopg://agenda:agenda_dev@localhost:5433/agenda
# Usuário da aplicação (sem privilégio de dono): a API e o seed conectam com ele.
# O nome e a senha daqui são usados por scripts/criar_papel_app.py para criar o papel.
DATABASE_URL=postgresql+psycopg://agenda_app:agenda_app_dev@localhost:5433/agenda
# Banco usado pelo pytest (mesmo servidor e usuários, outro nome). É recriado a cada execução.
TEST_DATABASE_NAME=agenda_test

# JWT: gere um valor aleatório longo (ex.: python -c "import secrets; print(secrets.token_urlsafe(48))")
JWT_SECRET=troque-por-um-valor-aleatorio-com-pelo-menos-32-caracteres
JWT_EXPIRA_MINUTOS=480

# Origens liberadas no CORS (JSON)
CORS_ORIGENS=["http://localhost:5173"]

# --- Proteção contra abuso (opcional: sem estas linhas valem os padrões; janelas em segundos) ---
# LIMITE_LOGIN_POR_IP=20
# LIMITE_LOGIN_JANELA=60
# LOGIN_FALHAS_PARA_BLOQUEAR=5
# LOGIN_FALHAS_JANELA=3600
# LOGIN_BLOQUEIO_INICIAL=60
# LOGIN_BLOQUEIO_MAXIMO=900
# LIMITE_SITE_POR_IP=120
# LIMITE_SITE_JANELA=60
# LIMITE_SITE_PEDIDOS_POR_IP=10
# LIMITE_SITE_PEDIDOS_JANELA=3600
# SITE_PENDENTES_POR_TELEFONE=3
# Conta do cliente no site: códigos de confirmação (1 pedido por telefone e IP a cada N s; N códigos
# gerados por telefone; N pedidos por IP; N erros no mesmo código por IP). Entrar usa os valores do login
# LIMITE_CODIGO_INTERVALO=60
# LIMITE_CODIGOS_POR_TELEFONE=5
# LIMITE_CODIGOS_POR_TELEFONE_JANELA=3600
# LIMITE_CODIGOS_POR_IP=10
# LIMITE_CODIGOS_POR_IP_JANELA=3600
# LIMITE_CODIGO_TENTATIVAS_POR_IP=5
# Validade da sessão do cliente no site (cookie), em dias
# SITE_SESSAO_DIAS=30

# --- Arquivos enviados (logo da loja) ---
# Pasta onde as logos ficam no disco (em produção, um volume persistente). Padrão: backend/arquivos
# ARQUIVOS_DIR=/caminho/para/arquivos
# Tamanho máximo da logo, em bytes (padrão 2 MB = 2097152). O corpo de qualquer requisição é limitado
# a esse valor mais 64 KB.
# LOGO_TAMANHO_MAXIMO=2097152

# --- Atrás de um proxy reverso (nginx, ver deploy/README.md) ---
# Lidas pelo uvicorn (não pela aplicação). Com --proxy-headers (já no Dockerfile), o IP do cliente vem
# do X-Forwarded-For, mas só quando a conexão chega de um destes IPs (separados por vírgula). O nginx na
# mesma máquina = 127.0.0.1 (padrão). Nunca use * com a API exposta.
# FORWARDED_ALLOW_IPS=127.0.0.1
# Endereço e porta do uvicorn no Docker (padrão 0.0.0.0:8000; com --network host use 127.0.0.1)
# UVICORN_HOST=0.0.0.0
# UVICORN_PORT=8000
